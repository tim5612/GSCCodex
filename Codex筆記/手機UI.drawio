        <mxCell id="59" value="畫面狀態  ○ 尚未辨識 ◌ 辨識處理中 ✓ OCR 已辨識並確認 ⚠ OCR 結果已被人工修改 ✕ 辨識失敗／要求重拍" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#D7E2DC;fontFamily=Microsoft JhengHei;fontSize=14;fontColor=#203D34;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1000" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="60" value="每個 OCR 欄位各自保存  • 最終文字 value • OCR 原文與信心值 • 原始照片 • 梯形校正照片 • 是否經人工確認／修改" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#D7E2DC;fontFamily=Microsoft JhengHei;fontSize=14;fontColor=#203D34;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="1000" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="61" value="欄位可配置不同規則  商品型號：大寫英文、數字、連字號 規格：允許空格、斜線、單位、小數點 批號：依批號格式驗證 裁切區域也可個別設定" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#D7E2DC;fontFamily=Microsoft JhengHei;fontSize=14;fontColor=#203D34;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="1000" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="62" value="資料流：手機拍照 → 伺服器校正與 OCR → 手機確認 → 回填欄位 → 組合「型號|S/NO|日期」→ 產生並留存 QR Code。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#D7E2DC;fontFamily=Microsoft JhengHei;fontSize=14;fontColor=#203D34;fillColor=none;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="1070" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ocr-field-flow" name="OCR 欄位流程">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="OCR 欄位操作｜照片為必填佐證" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontFamily=Microsoft JhengHei;fontSize=26;fontColor=#203D34;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="文字可由 OCR 辨識，也可由條碼掃描／人工輸入；兩條路徑都必須拍照並保存。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#506B62;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="4" value="01 / 欄位起點&#xA;&#xA;商品型號 *&#xA;┌────────────────┬────┐&#xA;│　　　　　　　　│ OCR│&#xA;└────────────────┴────┘&#xA;尚未取得資料 · 尚未拍照&#xA;&#xA;按 OCR 後先拍照。照片完成後，可使用 OCR 結果，也可改用條碼掃描／人工輸入。&#xA;&#xA;沒有照片 → 欄位不能完成" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAF9;strokeColor=#203A34;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#203D34;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="320" height="650" as="geometry" />
        </mxCell>
        <mxCell id="5" value="拍照並取得資料" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#17664F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="62" y="710" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="6" value="02 / 必拍照片&#xA;&#xA;拍攝完整標籤&#xA;&#xA;┌────────────────────┐&#xA;│　相機／照片預覽　　　│&#xA;│　　　　　　　　　　│&#xA;│　 WD – S22FHDB　　│&#xA;│　　　　　　　　　　│&#xA;│　 S/NO: 606...　　 │&#xA;└────────────────────┘&#xA;&#xA;伺服器保存：&#xA;✓ 原始照片&#xA;✓ 梯形校正照片" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAF9;strokeColor=#203A34;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#203D34;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="320" height="650" as="geometry" />
        </mxCell>
        <mxCell id="7" value="拍攝照片" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#17664F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="422" y="655" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="8" value="從相簿選取" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDF3EF;strokeColor=none;fontColor=#17664F;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="422" y="710" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="9" value="03A / OCR 辨識&#xA;&#xA;校正後標籤照片&#xA;┌────────────────────┐&#xA;│　 WD – S22FHDB　　│&#xA;│　▌▌▌▌▌▌▌▌▌　│&#xA;└────────────────────┘&#xA;&#xA;OCR 辨識結果&#xA;┌────────────────────┐&#xA;│ WD-S22FHDB　　　　│&#xA;└────────────────────┘&#xA;&#xA;☑ 我已對照照片，確認文字正確" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAF9;strokeColor=#203A34;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#203D34;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="760" y="130" width="320" height="650" as="geometry" />
        </mxCell>
        <mxCell id="10" value="使用此 OCR 結果" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#17664F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="782" y="655" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="11" value="改用掃碼／人工輸入" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDF3EF;strokeColor=none;fontColor=#17664F;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="782" y="710" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="12" value="03B / 掃碼或輸入&#xA;&#xA;已保存的校正照片&#xA;┌────────────────────┐&#xA;│　 WD – S22FHDB　　│&#xA;└────────────────────┘&#xA;&#xA;商品型號 *&#xA;┌────────────────┬────┐&#xA;│ WD-S22FHDB　　 │掃碼│&#xA;└────────────────┴────┘&#xA;可使用條碼掃描器，或直接輸入。&#xA;&#xA;☑ 我已對照照片，確認輸入值正確" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAF9;strokeColor=#203A34;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#203D34;align=left;verticalAlign=top;spacing=22;" vertex="1" parent="1">
          <mxGeometry x="1120" y="130" width="320" height="650" as="geometry" />
        </mxCell>
        <mxCell id="13" value="使用此輸入值" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#17664F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1142" y="655" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="14" value="返回 OCR 結果" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EDF3EF;strokeColor=none;fontColor=#17664F;fontFamily=Microsoft JhengHei;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1142" y="710" width="276" height="45" as="geometry" />
        </mxCell>
        <mxCell id="15" value="共同完成條件" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontFamily=Microsoft JhengHei;fontSize=18;fontColor=#203D34;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="815" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="16" value="照片已保存　＋　文字已有值　＋　使用者已對照照片確認　＝　OCR 欄位完成" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF2EC;strokeColor=#B6CBBF;fontFamily=Microsoft JhengHei;fontSize=17;fontColor=#203D34;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="855" width="1400" height="60" as="geometry" />
